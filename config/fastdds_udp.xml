<?xml version="1.0" encoding="UTF-8" ?>
<!--
  FastDDS participant profile for multi-robot warehouse simulation.

  Forces UDPv4-only transport, disabling shared memory (SHM) to avoid
  port lock exhaustion when 20+ DDS participants run concurrently in
  the same WSL2 instance.

  Referenced by all launch files via FASTRTPS_DEFAULT_PROFILES_FILE env var.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_transport</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="participant_profile" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_transport</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
