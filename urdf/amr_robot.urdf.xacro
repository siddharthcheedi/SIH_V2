<?xml version="1.0"?>
<robot name="amr_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    FIXED multi-robot tf strategy (§9):
    - Frame IDs are PLAIN: base_link, odom, lidar_link — no namespace prefix.
    - Namespace isolation is achieved by pushing each robot into its own
      ROS2 namespace, which causes /tf → /<ns>/tf automatically via
      nav2_bringup's internal remapping.
    - This lets one shared nav2_params_template.yaml work unmodified for
      every robot — no per-robot frame-name templating needed.
  -->

  <xacro:arg name="robot_name" default="amr_1"/>
  <xacro:property name="ns" value="$(arg robot_name)"/>

  <!-- Per-robot chassis color: passed from launch for visual distinction. -->
  <xacro:arg name="chassis_r" default="0.25"/>
  <xacro:arg name="chassis_g" default="0.25"/>
  <xacro:arg name="chassis_b" default="0.28"/>
  <xacro:arg name="chassis_a" default="1.0"/>

  <xacro:property name="chassis_len" value="0.5"/>
  <xacro:property name="chassis_wid" value="0.35"/>
  <xacro:property name="chassis_hgt" value="0.18"/>
  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_width" value="0.035"/>
  <xacro:property name="wheel_separation" value="0.40"/>
  <xacro:property name="caster_radius" value="0.03"/>

  <!-- ─── Materials ──────────────────────────────────────────────────── -->
  <material name="chassis_color">
    <color rgba="$(arg chassis_r) $(arg chassis_g) $(arg chassis_b) $(arg chassis_a)"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="lidar_red">
    <color rgba="0.7 0.05 0.05 1.0"/>
  </material>

  <!-- ─── Base link ──────────────────────────────────────────────────── -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${chassis_len} ${chassis_wid} ${chassis_hgt}"/></geometry>
      <origin xyz="0 0 ${chassis_hgt/2}" rpy="0 0 0"/>
      <material name="chassis_color"/>
    </visual>
    <collision>
      <geometry><box size="${chassis_len} ${chassis_wid} ${chassis_hgt}"/></geometry>
      <origin xyz="0 0 ${chassis_hgt/2}" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.08" ixy="0.0" ixz="0.0" iyy="0.12" iyz="0.0" izz="0.15"/>
    </inertial>
  </link>

  <!-- Gazebo material override (SDF visual material, not URDF material) -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
    <visual>
      <material>
        <ambient>$(arg chassis_r) $(arg chassis_g) $(arg chassis_b) $(arg chassis_a)</ambient>
        <diffuse>$(arg chassis_r) $(arg chassis_g) $(arg chassis_b) $(arg chassis_a)</diffuse>
      </material>
    </visual>
  </gazebo>

  <!-- ─── Drive wheels ───────────────────────────────────────────────── -->
  <xacro:macro name="drive_wheel" params="side y_offset">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.6"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left"  y_offset="${wheel_separation/2}"/>
  <xacro:drive_wheel side="right" y_offset="-${wheel_separation/2}"/>

  <!-- ─── Caster wheels ──────────────────────────────────────────────── -->
  <xacro:macro name="caster" params="prefix x_offset">
    <link name="${prefix}_caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <surface>
          <friction>
            <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <mass value="0.15"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
      </inertial>
    </link>
    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster_link"/>
      <origin xyz="${x_offset} 0 -${wheel_radius - caster_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:caster prefix="front" x_offset="${chassis_len/2 - 0.05}"/>
  <xacro:caster prefix="rear"  x_offset="-${chassis_len/2 + 0.05}"/>

  <!-- ─── Lidar ──────────────────────────────────────────────────────── -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="lidar_red"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${chassis_hgt + 0.03}" rpy="0 0 0"/>
  </joint>

  <!-- ─── Gazebo diff-drive controller ───────────────────────────────── -->
  <!--
    PLAIN frame names: odom, base_footprint.
    The namespace tag scopes cmd_vel/odom topics under /<robot_name>/.
    TF frames stay plain — namespace isolation comes from the launch-level
    /tf → /<ns>/tf topic remapping, NOT from frame-name prefixing.
  -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>${ns}</namespace>
        <remapping>odom:=odom</remapping>
        <remapping>/tf:=/${ns}/tf</remapping>
        <remapping>/tf_static:=/${ns}/tf_static</remapping>
      </ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${wheel_radius * 2}</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <update_rate>50.0</update_rate>
    </plugin>
  </gazebo>

  <!-- ─── 2D lidar sensor ────────────────────────────────────────────── -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>${ns}</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
